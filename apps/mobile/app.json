{
  "expo": {
    "name": "MODO GYM",
    "slug": "modo-gym",
    "version": "2.0.0",
    "scheme": "modogym",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.modogym.app"
    },
    "android": {
      "package": "com.modogym.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET"]
    },
    "splash": {
      "backgroundColor": "#0d0d0f"
    },
    "androidStatusBar": {
      "backgroundColor": "#0d0d0f"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
