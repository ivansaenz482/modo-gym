# URL de la API para la app móvil.
# - Desarrollo (Expo Go): si no defines nada, usa extra.apiUrl (app.config.js) = http://localhost:3000
#   y en Android emulador cae a http://10.0.2.2:3000.
# - Builds EAS: la define eas.json (perfil preview/production). También puedes sobrescribirla aquí
#   para builds locales (`npx expo export` / run:android) con tu IP de LAN, p. ej.:
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
