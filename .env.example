# Copia este archivo a .env y ajusta los valores.
# Para desarrollo local fuera de Docker usa el host "localhost".
# Dentro de Docker el host de Postgres es "postgres".

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=modogym
POSTGRES_PASSWORD=modogym_dev_password
POSTGRES_DB=modogym
POSTGRES_PORT=55432
DATABASE_URL=postgresql://modogym:modogym_dev_password@localhost:55432/modogym?schema=public

# --- API (NestJS) ---
API_PORT=3000
NODE_ENV=development
JWT_SECRET=cambia_esta_clave_por_una_muy_segura_32+chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- IA / N8n ---
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=cambia_por_api_key_del_webhook_de_n8n
N8N_TIMEOUT_MS=60000

# --- N8n (self-hosted) ---
N8N_VERSION=latest
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_USER=admin
N8N_PASSWORD=modogym_n8n_password

# --- App / QR ---
APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.modogym.app
WEB_URL=http://localhost:5173

TZ=America/Guayaquil
