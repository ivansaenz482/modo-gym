# Copia este archivo a .env y ajusta los valores.
# Para desarrollo local fuera de Docker usa el host "localhost".
# Dentro de Docker el host de Postgres es "postgres".

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=modogym
POSTGRES_PASSWORD=modogym_dev_password
POSTGRES_DB=modogym
POSTGRES_PORT=55432
DATABASE_URL=postgresql://modogym:modogym_dev_password@localhost:55432/modogym?schema=public

# --- API (NestJS) ---
API_PORT=3000
NODE_ENV=development
JWT_SECRET=cambia_esta_clave_por_una_muy_segura_32+chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- IA / N8n ---
N8N_WEBHOOK_URL=http://localhost:5678
# La clave de la API pública de N8n NO se puede definir por env en N8n 2.x:
# `npm run n8n:setup` la crea automáticamente y la guarda aquí.
N8N_API_KEY=
N8N_TIMEOUT_MS=60000
# Cuenta owner de N8n (User Management) usada por `npm run n8n:setup`.
N8N_OWNER_EMAIL=admin@modogym.com
N8N_OWNER_PASSWORD=cambia_esta_contraseña
# Clave de OpenAI para que el workflow de rutinas use IA real (opcional en dev).
OPENAI_API_KEY=

# --- N8n (self-hosted) ---
N8N_VERSION=latest
N8N_HOST=localhost
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=modogym_n8n_password

# --- App / QR ---
# URL directa del APK servido por la API (/api/downloads/modo-gym.apk).
# Copia el APK de build a apps/api/downloads/modo-gym.apk y ajusta el host
# a la IP LAN o dominio público desde el que escaneen el QR.
APP_DOWNLOAD_URL=http://TU_IP:3000/api/downloads/modo-gym.apk
WEB_URL=http://localhost:5173

TZ=America/Guayaquil
